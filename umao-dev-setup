STACKS_BY_TAG = {s.tag: s for s in STACKS}

# ── Privilege helpers ──────────────────────────────────────────────────────────
#
# sudo can only prompt on a TTY: launched from the app menu / desktop there is
# none, so bare `sudo ...` fails instantly ("a terminal is required") while the
# GUI carries on as if it worked. pkexec authenticates through the polkit GUI
# agent instead. Note pkexec and sudo do NOT share auth caches — that is why
# entering a password for the pacman step never "carries over" to sudo calls.

def root_runner() -> list[str]:
    if os.geteuid() == 0:
        return []
    if sys.stdin.isatty():
        return ["sudo"]
    return ["pkexec"]


ASKPASS_CANDIDATES = [
    "/usr/bin/ksshaskpass",
    "/usr/lib/ssh/x11-ssh-askpass",
    "/usr/bin/ssh-askpass",
]


def yay_invocation():
    """(env, extra_flags) so yay's internal sudo can prompt, or (None, [])
    when AUR installs cannot work in this session (no TTY, no askpass)."""
    if sys.stdin.isatty():
        return dict(os.environ), []
    for helper in ASKPASS_CANDIDATES:
        if os.path.isfile(helper):
            env = dict(os.environ)
            env["SUDO_ASKPASS"] = helper
            return env, ["--sudoflags", "-A"]
    return None, []


# ── Post-install hooks ─────────────────────────────────────────────────────────

def run_post_hooks(tags: list[str]) -> list[str]:
    """Run post-install hooks. Returns a list of failed step descriptions.

    Root-level steps (systemctl/usermod/initdb/npm -g) are batched into ONE
    escalated bash call so the user authenticates at most once more, and
    every failure is reported instead of being silently swallowed.
    """
    failures: list[str] = []
    root_steps: list[tuple[str, str]] = []  # (description, shell snippet)

    NPM_GLOBALS = {
        "claude-code": "@anthropic-ai/claude-code",
        "codex": "@openai/codex",
        "gemini-cli": "@google/gemini-cli",
    }

    for tag in tags:
        stack = STACKS_BY_TAG.get(tag)
        if not stack:
            continue
        if tag == "rust" and shutil.which("rustup"):
            r = subprocess.run(["rustup", "default", "stable"], capture_output=True)
            if r.returncode != 0:
                failures.append("rustup default stable")
        elif tag in NPM_GLOBALS and shutil.which("npm"):
            # npm -g writes to /usr/lib/node_modules on Arch — needs root.
            spec = NPM_GLOBALS[tag]
            root_steps.append((f"npm install -g {spec}",
                               f"npm install -g {shlex.quote(spec)}"))
        elif tag == "aider" and shutil.which("pipx"):
            r = subprocess.run(["pipx", "install", "aider-chat"], capture_output=True)
            if r.returncode != 0:
                failures.append("pipx install aider-chat")
            else:
                # pipx installs into ~/.local/bin, which is not on PATH by
                # default — without this `aider` is unusable and the stack's
                # own check_cmd never detects it afterwards.
                e = subprocess.run(["pipx", "ensurepath"], capture_output=True)
                if e.returncode != 0:
                    failures.append("pipx ensurepath (aider may not be on PATH)")
        elif tag == "ollama" and shutil.which("ollama"):
            root_steps.append(("enable ollama.service",
                               "systemctl enable --now ollama.service"))
        elif tag == "docker" and shutil.which("docker"):
            root_steps.append(("enable docker.service",
                               "systemctl enable --now docker.service"))
            user = os.environ.get("SUDO_USER") or os.environ.get("USER", "")
            if user:
                groups_out = subprocess.run(["groups", user], capture_output=True, text=True)
                if "docker" not in groups_out.stdout:
                    root_steps.append((f"add {user} to docker group",
                                       f"usermod -aG docker {shlex.quote(user)}"))
        elif tag == "postgresql" and shutil.which("postgres"):
            root_steps.append(("initialize PostgreSQL data dir",
                               "[ -d /var/lib/postgres/data/base ] || "
                               "{ install -d -o postgres -g postgres /var/lib/postgres/data && "
                               "sudo -u postgres initdb -D /var/lib/postgres/data; }"))
            root_steps.append(("enable postgresql.service",
                               "systemctl enable --now postgresql.service"))
        elif tag == "redis" and shutil.which("redis-server"):
            root_steps.append(("enable redis.service",
                               "systemctl enable --now redis.service"))

    if root_steps:
        marker = "UMAO_HOOK_FAILED::"
        script = "\n".join(
            f"( {snippet} ) >/dev/null 2>&1 || echo {shlex.quote(marker + desc)}"
            for desc, snippet in root_steps
        )
        r = subprocess.run(root_runner() + ["bash", "-c", script],
                           capture_output=True, text=True)
        if r.returncode != 0 and marker not in (r.stdout or ""):
            # Escalation itself failed (auth cancelled / no method available)
            failures.extend(desc for desc, _ in root_steps)
        else:
            for line in (r.stdout or "").splitlines():
                if line.startswith(marker):
                    failures.append(line[len(marker):])

    return failures


# ── Helpers ────────────────────────────────────────────────────────────────────

def has_display() -> bool:
    return bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))

def dedupe_packages(tags: list[str]) -> list[str]:
    seen = {}
    for tag in tags:
        stack = STACKS_BY_TAG.get(tag)
        if stack:
            for pkg in stack.packages:
                if pkg not in seen:
                    seen[pkg] = True
    return list(seen.keys())

def classify_packages(pkgs: list[str]) -> tuple[list[str], list[str]]:
    """Split into (official, aur) packages.

    A `pacman -Si` timeout or a missing pacman used to raise straight out of
    here, killing the kdialog/text flows with a traceback and aborting the GUI
    install. Treat lookup failures as "not official" (the AUR path warns
    rather than silently doing nothing).
    """
    official, aur = [], []
    for pkg in pkgs:
        try:
            ret = subprocess.run(["pacman", "-Si", pkg],
                                 capture_output=True, timeout=15)
            (official if ret.returncode == 0 else aur).append(pkg)
        except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
            aur.append(pkg)
    return official, aur


# ═══════════════════════════════════════════════════════════════════════════════
# QML GUI mode (PyQt6)
# ═══════════════════════════════════════════════════════════════════════════════

def run_qml() -> None:
    from PyQt6.QtCore import (
        QObject, QThread, QUrl, pyqtSignal, pyqtSlot, pyqtProperty, QVariant
    )
    from PyQt6.QtGui import QGuiApplication, QIcon
    from PyQt6.QtQml import QQmlApplicationEngine

    class InstallWorker(QThread):
        progressChanged = pyqtSignal(int, int)
        currentPackageChanged = pyqtSignal(str)
        packageCompleted = pyqtSignal(str)
        installComplete = pyqtSignal(str, str)
        installError = pyqtSignal(str)

        def __init__(self, tags: list[str], parent=None):
            super().__init__(parent)
            self.tags = tags

        def run(self):
            try:
                all_pkgs = dedupe_packages(self.tags)
                if not all_pkgs:
                    self.installError.emit("No packages to install.")
                    return

                total = len(all_pkgs)
                official, aur = classify_packages(all_pkgs)
                completed = set()
                done = 0

                # Install official packages via single escalated call.
                if official:
                    self.currentPackageChanged.emit(official[0])
                    # pacman's output is localized: without LC_ALL=C the
                    # "installing <pkg>" lines we scrape below never match on a
                    # non-English system and the bar sits at 0 until the end.
                    env = dict(os.environ, LC_ALL="C", LANG="C")
                    proc = subprocess.Popen(
                        root_runner() + ["pacman", "-Syu", "--needed", "--noconfirm"] + official,
                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                        text=True, bufsize=1, env=env,
                    )
                    for line in proc.stdout:
                        line = line.strip()
                        for prefix in ("installing ", "reinstalling "):
                            if line.lower().startswith(prefix):
                                pkg = line[len(prefix):].rstrip(".").strip()
                                if pkg in official and pkg not in completed:
                                    completed.add(pkg)
                                    done += 1
                                    self.packageCompleted.emit(pkg)
                                    self.progressChanged.emit(done, total)
                                    remaining = [p for p in official if p not in completed]
                                    if remaining:
                                        self.currentPackageChanged.emit(remaining[0])
                    proc.wait()
                    if proc.returncode != 0:
                        # Any nonzero exit means the transaction did not
                        # complete. Previously this was guarded by
                        # `and not completed`, so a failure *after* some
                        # "installing" lines (e.g. disk full mid-transaction)
                        # fell through and every package was marked done —
                        # reporting a clean success for a broken install.
                        self.installError.emit(
                            "Installation failed (exit code "
                            + str(proc.returncode)
                            + "). Authentication may have been cancelled, or the "
                            "transaction failed part-way through."
                        )
                        return
                    # Success: pacman -S --needed is all-or-nothing, so anything
                    # not seen in the output was already present.
                    for pkg in official:
                        if pkg not in completed:
                            completed.add(pkg)
                            done += 1
                            self.packageCompleted.emit(pkg)
                            self.progressChanged.emit(done, total)

                # Install AUR packages
                warnings = []
                failed_aur = []
                if aur:
                    env, extra_flags = yay_invocation()
                    if shutil.which("yay") and env is not None:
                        for pkg in aur:
                            self.currentPackageChanged.emit(pkg)
                            r = subprocess.run(
                                ["yay", "-S", "--needed", "--noconfirm", *extra_flags, pkg],
                                capture_output=True, env=env,
                            )
                            if r.returncode != 0:
                                failed_aur.append(pkg)
                            done += 1
                            self.packageCompleted.emit(pkg)
                            self.progressChanged.emit(done, total)
                        if failed_aur:
                            warnings.append(
                                "AUR packages failed to install: "
                                + ", ".join(failed_aur)
                            )
                    else:
                        reason = ("yay is not installed"
                                  if not shutil.which("yay")
                                  else "no way to prompt for the AUR helper's password")
                        warnings.append(
                            f"{reason}. These AUR packages need manual "
                            "install: " + ", ".join(aur)
                        )
                        for pkg in aur:
                            done += 1
                            self.progressChanged.emit(done, total)

                hook_failures = run_post_hooks(self.tags)
                if hook_failures:
                    warnings.append(
                        "Post-install steps failed: " + "; ".join(hook_failures)
                    )
                aur_warning = "\n".join(warnings)

                stack_names = []
                for tag in self.tags:
                    s = STACKS_BY_TAG.get(tag)
                    if s:
                        stack_names.append(s.display_name)
                installed_count = len(all_pkgs) - len(failed_aur)
                summary = (
                    f"Installed {installed_count} of {len(all_pkgs)} packages across "
                    f"{len(self.tags)} stacks: {', '.join(stack_names)}."
                )
                self.installComplete.emit(summary, aur_warning)

            except Exception as e:
                self.installError.emit(str(e))

    class DevSetupBackend(QObject):
        progressChanged = pyqtSignal(int, int, arguments=["current", "total"])
        currentPackageChanged = pyqtSignal(str, arguments=["pkg"])
        packageCompleted = pyqtSignal(str, arguments=["pkg"])
        installComplete = pyqtSignal(str, str, arguments=["summary", "warning"])
        installError = pyqtSignal(str, arguments=["error"])

        def __init__(self, parent=None):
            super().__init__(parent)
            self._stacks = [s.to_dict() for s in STACKS]
            self._categories = CATEGORIES
            self._worker = None

        @pyqtProperty("QVariantList", constant=True)
        def stacks(self):
            return self._stacks

        @pyqtProperty("QVariantList", constant=True)
        def categories(self):
            return self._categories

        @pyqtSlot("QVariantList")
        def install(self, tags):
            tag_list = list(tags)
            self._worker = InstallWorker(tag_list, self)
            self._worker.progressChanged.connect(self.progressChanged)
            self._worker.currentPackageChanged.connect(self.currentPackageChanged)
            self._worker.packageCompleted.connect(self.packageCompleted)
            self._worker.installComplete.connect(self.installComplete)
            self._worker.installError.connect(self.installError)
            self._worker.start()

    app = QGuiApplication(sys.argv)
    app.setApplicationName("UmaOS Dev Setup")

    icon_path = "/usr/share/umaos/dev-setup/icon.png"
    if os.path.exists(icon_path):
        app.setWindowIcon(QIcon(icon_path))

    engine = QQmlApplicationEngine()
    backend = DevSetupBackend()
    engine.rootContext().setContextProperty("backend", backend)

    qml_dir = "/usr/share/umaos/dev-setup"
    engine.addImportPath(qml_dir)
    engine.load(QUrl.fromLocalFile(os.path.join(qml_dir, "main.qml")))

    if not engine.rootObjects():
        print("Error: Failed to load QML interface.", file=sys.stderr)
        sys.exit(1)

    sys.exit(app.exec())


# ═══════════════════════════════════════════════════════════════════════════════
# kdialog fallback
# ═══════════════════════════════════════════════════════════════════════════════

def run_kdialog() -> None:
    TITLE = "UmaOS Dev Setup"
    ICON = "/usr/share/umaos/dev-setup/icon.png"

    args = []
    for s in STACKS:
        # Nothing is pre-checked. Pre-checking already-installed stacks meant a
        # user who just hit OK reinstalled everything already present — the
        # opposite of the README's "already-installed stacks are skipped", and
        # inconsistent with the QML UI, which preselects nothing.
        state = "off"
        n = len(s.packages)
        label = f"{s.display_name}  ({n} package{'s' if n != 1 else ''})"
        if s.installed:
            label += "  [installed]"
        args += [s.tag, label, state]

    try:
        result = subprocess.run(
            ["kdialog", "--icon", ICON, "--title", TITLE,
             "--checklist", "Select development stacks to install:"] + args,
            capture_output=True, text=True,
        )
    except FileNotFoundError:
        return run_text()

    if result.returncode != 0 or not result.stdout.strip():
        return

    selection = result.stdout.strip().replace('"', '').split()
    tags = [t for t in selection if t in STACKS_BY_TAG]
    if not tags:
        return

    all_pkgs = dedupe_packages(tags)
    stack_names = [STACKS_BY_TAG[t].display_name for t in tags]

    summary = "Install the following stacks?\n\n"
    summary += "\n".join(f"  - {n}" for n in stack_names)
    summary += f"\n\n{len(all_pkgs)} packages total: {' '.join(all_pkgs)}"

    ret = subprocess.run(
        ["kdialog", "--icon", ICON, "--title", TITLE, "--yesno", summary],
        capture_output=True,
    )
    if ret.returncode != 0:
        return

    official, aur = classify_packages(all_pkgs)
    total = len(all_pkgs)
    # kdialog --progressbar prints "<service> <objectpath>" — two space-separated
    # tokens. Passing the whole string as ONE qdbus argument made every
    # subsequent call a silent no-op: the bar never advanced and never closed.
    dbus_ref = subprocess.run(
        ["kdialog", "--icon", ICON, "--title", TITLE,
         "--progressbar", "Preparing installation...", str(total)],
        capture_output=True, text=True,
    ).stdout.split()

    done = 0

    def update_progress(label, value):
        if len(dbus_ref) < 2:
            return
        try:
            subprocess.run(["qdbus6", *dbus_ref, "setLabelText", label],
                           capture_output=True)
            subprocess.run(["qdbus6", *dbus_ref, "Set", "", "value", str(value)],
                           capture_output=True)
        except FileNotFoundError:
            # qdbus6 (qt6-tools) missing: progress updates are cosmetic, so
            # degrade instead of crashing the whole install flow.
            pass

    def close_progress():
        if len(dbus_ref) < 2:
            return
        try:
            subprocess.run(["qdbus6", *dbus_ref, "close"], capture_output=True)
        except FileNotFoundError:
            pass

    problems = []

    if official:
        # One escalated batch call = one authentication prompt.
        update_progress(f"Installing {len(official)} packages...", done)
        r = subprocess.run(root_runner() + ["pacman", "-S", "--needed", "--noconfirm"] + official,
                           capture_output=True)
        if r.returncode != 0:
            problems.append("pacman install failed (cancelled authentication?): "
                            + " ".join(official))
        done += len(official)
        update_progress("Official packages done.", done)

    if aur:
        env, extra_flags = yay_invocation()
        if shutil.which("yay") and env is not None:
            for pkg in aur:
                update_progress(f"Installing {pkg} (AUR)...", done)
                r = subprocess.run(["yay", "-S", "--needed", "--noconfirm", *extra_flags, pkg],
                                   capture_output=True, env=env)
                if r.returncode != 0:
                    problems.append(f"AUR install failed: {pkg}")
                done += 1
        else:
            problems.append("AUR packages need manual install: " + " ".join(aur))
            done += len(aur)

    update_progress("Done!", total)
    close_progress()

    hook_failures = run_post_hooks(tags)
    if hook_failures:
        problems.append("Post-install steps failed: " + "; ".join(hook_failures))

    if problems:
        msg = "Dev setup finished with problems:\n\n" + "\n".join(problems)
    else:
        msg = "Umazing! Dev environment is ready."

    subprocess.run(["kdialog", "--icon", ICON, "--title", TITLE,
                     "--passivepopup", msg, "5"], capture_output=True)
    subprocess.run(["kdialog", "--icon", ICON, "--title", TITLE,
                     "--msgbox", msg], capture_output=True)


# ═══════════════════════════════════════════════════════════════════════════════
# Text fallback
# ═══════════════════════════════════════════════════════════════════════════════

def run_text() -> None:
    print()
    print("  UmaOS Dev Environment Setup")
    print("  (text mode — no graphical session detected)")
    print("  " + "━" * 43)
    print()

    for i, s in enumerate(STACKS):
        marker = " *" if s.installed else "  "
        pkgs_str = " ".join(s.packages)
        print(f"  {marker} {i+1:2d}) {s.display_name:<22s}  [{pkgs_str}]")

    print()
    print("  Enter stack numbers separated by spaces (e.g. 1 3 5)")
    print("  Or 'all' to install everything, 'q' to quit.")
    print()

    try:
        inp = input("  Select stacks: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return

    if inp in ("q", ""):
        print("  Nothing to install.")
        return

    tags = []
    if inp == "all":
        tags = [s.tag for s in STACKS]
    else:
        for num in inp.split():
            if not num.isdigit():
                print(f"  Skipping invalid selection: {num}")
                continue
            idx = int(num) - 1
            if 0 <= idx < len(STACKS):
                tags.append(STACKS[idx].tag)
            else:
                print(f"  Skipping invalid selection: {num}")

    if not tags:
        print("  No valid stacks selected.")
        return

    all_pkgs = dedupe_packages(tags)
    stack_names = [STACKS_BY_TAG[t].display_name for t in tags]

    print()
    print(f"  Installing: {', '.join(stack_names)}")
    print(f"  Packages:   {' '.join(all_pkgs)}")
    print()

    official, aur = classify_packages(all_pkgs)

    text_problems = []

    if official:
        print("  >> Installing from official repos...")
        # root_runner() instead of a hardcoded sudo: crashes on sudo-less
        # systems and pointlessly re-prompts when already root. -Syu because a
        # plain -S against a stale sync db 404s on a freshly imaged system.
        r = subprocess.run(root_runner() + ["pacman", "-Syu", "--needed", "--noconfirm"] + official)
        if r.returncode != 0:
            text_problems.append(f"pacman failed (exit {r.returncode}): {' '.join(official)}")

    if aur:
        if shutil.which("yay"):
            print("  >> Installing from AUR...")
            r = subprocess.run(["yay", "-S", "--needed", "--noconfirm"] + aur)
            if r.returncode != 0:
                text_problems.append(f"yay failed (exit {r.returncode}): {' '.join(aur)}")
        else:
            print("  WARNING: yay not found. These AUR packages need manual install:")
            for pkg in aur:
                print(f"    {pkg}")
            text_problems.append("AUR packages need manual install: " + " ".join(aur))

    text_problems += run_post_hooks(tags)

    print()
    if text_problems:
        # Previously this printed "Umazing! Dev environment is ready." even
        # after a completely failed install: only hook failures were checked.
        print("  Completed with problems:")
        for f in text_problems:
            print(f"    - {f}")
    else:
        print("  Umazing! Dev environment is ready.")
    print()


# ═══════════════════════════════════════════════════════════════════════════════
# Entry point
