def main() -> None:
    if "--text" in sys.argv:
        return run_text()

    if not has_display():
        return run_text()

    # Try PyQt6 QML GUI
    try:
        import PyQt6.QtCore  # noqa: F401
        return run_qml()
    except ImportError:
        pass

    # Try kdialog
    if shutil.which("kdialog"):
        return run_kdialog()

    return run_text()


if __name__ == "__main__":
    main()
